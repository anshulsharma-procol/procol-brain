# Procol Brain API

PORT=4000

# Where the agents live.
#   mounted  - clara/dev/qa are served by this process behind /agents/<id>.
#              A2A calls still go over real HTTP through the same client.
#   separate - the orchestrator calls the URLs in AGENT_URLS instead, so the
#              agents can be split into their own services without a code change.
AGENT_MODE=mounted
AGENT_URLS=http://localhost:4101,http://localhost:4102,http://localhost:4103

# Origins allowed to call the API (the console and any client dashboard
# embedding the chat widget). Comma-separated, or * for anything.
CORS_ORIGIN=*

# How fast a run plays out. 1 is real agent latency as scripted; 0.4 makes a
# full run fit inside a demo slot; 3 slows it down for a walkthrough.
RUN_SPEED=1

# Persist state to disk so a restart mid-rehearsal does not lose the board.
# Empty disables it and every boot starts from the seed.
STATE_FILE=.state.json

# Timeouts (ms). A hang is worse than a failure, because a failure renders.
A2A_TIMEOUT_MS=30000

# Point the console and the embedded chat widget at the Brain API.
#
#   set    -> both surfaces read the live service in ../backend
#   unset  -> the console replays the scenario files in
#             src/platform/scenarios/ and the widget its bundled demo,
#             so the frontend still runs with the backend stopped
#
# The widget is handed ${VITE_BRAIN_API_URL}/chat automatically.
VITE_BRAIN_API_URL=http://localhost:4000/api

# Optional, sent as `Authorization: Bearer`.
# VITE_BRAIN_API_TOKEN=

# Point the console and the embedded chat widget at the Brain API.
#
#   VITE_BRAIN_API_TARGET  the backend's origin. Only the dev/preview server
#                          reads it: it proxies /api there and adds ngrok's
#                          `ngrok-skip-browser-warning` header to every
#                          request, which is the only way SSE can work through
#                          a free tunnel (EventSource cannot send headers).
#
#   VITE_BRAIN_API_URL     the base the app itself requests.
#                          `/api`  -> same origin, through the proxy above.
#                                    No CORS, no interstitial. Use this.
#                          absolute -> straight at the backend. Needs the
#                                    backend to allow this origin, and SSE
#                                    will meet the interstitial on a free
#                                    ngrok tunnel.
#                          unset   -> the console replays the fixtures in
#                                    src/platform/api/fixtures.json and the
#                                    widget its bundled demo, so the frontend
#                                    still runs with the backend stopped.
#
# The widget is handed ${VITE_BRAIN_API_URL}/chat automatically.

VITE_BRAIN_API_TARGET=http://localhost:4000
VITE_BRAIN_API_URL=/api

# The embedded chat widget is a separate product with its own vocabulary under
# `/chat`. The tunnelled backend above serves 25 endpoints and none of them is
# a /chat route, so every widget call 404s against it: similar-issue search,
# raising a ticket and the investigation poll all fail. Point it at a service
# that does serve /chat (the in-repo backend does) to keep the widget working
# meanwhile:
#
# VITE_BRAIN_CHAT_API_URL=http://localhost:4000/api/chat
#
# Leave it unset once the deployed Brain serves /chat, and the widget follows
# VITE_BRAIN_API_URL again.

# Optional, sent as `Authorization: Bearer`.
# VITE_BRAIN_API_TOKEN=
